# Ajustes obligatorios en producción
DJANGO_SECRET_KEY=reemplace-por-un-valor-aleatorio-largo
DJANGO_ALLOWED_HOSTS=auditoria.mined.gob.sv
DJANGO_CSRF_TRUSTED_ORIGINS=https://auditoria.mined.gob.sv

# PostgreSQL
POSTGRES_DB=auditoria
POSTGRES_USER=auditoria_app
POSTGRES_PASSWORD=reemplace-esta-clave
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Si PostgreSQL corre en este mismo servidor se permite disable en loopback.
# Para otro servidor: verify-full y ruta al certificado de la autoridad emisora.
POSTGRES_SSLMODE=disable
POSTGRES_SSLROOTCERT=

# Infraestructura
# HTTPS y antivirus son obligatorios; no se pueden desactivar en producción.
DJANGO_HSTS_SECONDS=3600
FILE_SCAN_REQUIRED=true
FILE_MAX_UPLOAD_MB=20
PRIVATE_MEDIA_ROOT=/var/lib/endpoint/private
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
DEFAULT_FROM_EMAIL=no-responder@mined.gob.sv
PUBLIC_BASE_URL=https://auditoria.mined.gob.sv
EMAIL_HOST=smtp.institucional.example
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
