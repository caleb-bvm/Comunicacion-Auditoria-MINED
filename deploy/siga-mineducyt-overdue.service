[Unit]
Description=Procesar vencimientos de recomendaciones
After=network.target

[Service]
Type=oneshot
User=siga-mineducyt
Group=siga-mineducyt
WorkingDirectory=/srv/siga-mineducyt
EnvironmentFile=/etc/siga-mineducyt/production.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/srv/siga-mineducyt/.venv/bin/python manage.py process_overdue_recommendations
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
