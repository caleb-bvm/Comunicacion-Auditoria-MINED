[Unit]
Description=Procesar vencimientos de recomendaciones
After=network.target

[Service]
Type=oneshot
User=endpoint
Group=endpoint
WorkingDirectory=/srv/endpoint
EnvironmentFile=/etc/endpoint/production.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/srv/endpoint/.venv/bin/python manage.py process_overdue_recommendations
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
