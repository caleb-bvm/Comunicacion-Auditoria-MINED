# Copiar a /etc/siga-mineducyt/backup.env (root:root, 0600).
# La clave del repositorio va aparte en /etc/siga-mineducyt/restic-password
# (root:root, 0600) y debe guardarse también fuera del servidor: sin ella las
# copias no se pueden restaurar.

# Repositorio fuera del servidor. Opciones habituales:
#   rest:https://usuario:clave@respaldos.mined.gob.sv:8000/siga-mineducyt
#   s3:https://almacenamiento.example/siga-mineducyt
RESTIC_REPOSITORY=rest:https://usuario:clave@respaldos.example:8000/siga-mineducyt
# Para un repositorio S3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Retención (copias diarias, semanales y mensuales que se conservan).
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=24
# Con un rest-server en modo --append-only el servidor no permite borrar desde
# aquí: usar false y aplicar la retención en el servidor del repositorio.
BACKUP_PRUNE=true
# Días que se conservan las copias locales previas a cada despliegue.
BACKUP_PREDEPLOY_DAYS=30
# Porción de los datos que se relee cada día para comprobar el repositorio.
BACKUP_CHECK_SUBSET=2%
