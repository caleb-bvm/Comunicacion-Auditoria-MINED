[Unit]
Description=Seguimiento de Auditoría Educativa
After=network.target

[Service]
User=endpoint
Group=endpoint
WorkingDirectory=/srv/endpoint
EnvironmentFile=/etc/endpoint/production.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStartPre=/srv/endpoint/.venv/bin/python manage.py check --deploy --fail-level ERROR
ExecStart=/srv/endpoint/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 180 --max-requests 500 --max-requests-jitter 50 --error-logfile -
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=endpoint
ReadWritePaths=/var/lib/endpoint
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
